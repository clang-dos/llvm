; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; SjLj exceptions in the large model (see sjlj-eh.ll): the personality is a
; far code pointer, so the jump buffer starts 2 bytes later, and it keeps the
; dispatch's segment (CS) after SP. The type table holds far pointers.
; RUN: llc -mtriple=i8086-pc-msdos -target-abi=large < %s | FileCheck %s --check-prefix=CHECK

@_ZTIi = external addrspace(2) constant ptr addrspace(2)

declare void @may_throw(i16) addrspace(5)
declare i32 @__gxx_personality_sj0(...) addrspace(5)
declare ptr addrspace(2) @__cxa_begin_catch(ptr addrspace(2)) addrspace(5)
declare void @__cxa_end_catch() addrspace(5)

; The dispatch: the call site picks the landing pad from a table in CS.
define i16 @catcher(i16 %x) addrspace(5) personality ptr addrspace(5) @__gxx_personality_sj0 {
; CHECK-LABEL: catcher:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    pushw %bp
; CHECK-NEXT:    movw %sp, %bp
; CHECK-NEXT:    pushw %di
; CHECK-NEXT:    pushw %si
; CHECK-NEXT:    subw $40, %sp
; CHECK-NEXT:    movw 6(%bp), %si
; CHECK-NEXT:    movw $___gxx_personality_sj0@SEG, -20(%bp)
; CHECK-NEXT:    movw $___gxx_personality_sj0, -22(%bp)
; CHECK-NEXT:    movw $GCC_except_table0, -18(%bp)
; CHECK-NEXT:    movw %bp, -16(%bp)
; CHECK-NEXT:    movw %sp, -12(%bp)
; CHECK-NEXT:    movw $.LBB0_3, -14(%bp)
; CHECK-NEXT:    movw %cs, -10(%bp)
; CHECK-NEXT:    leaw -44(%bp), %ax
; CHECK-NEXT:    movw %ax, -6(%bp) # 2-byte Spill
; CHECK-NEXT:    pushw %ax
; CHECK-NEXT:    lcallw $__Unwind_SjLj_Register@SEG, $__Unwind_SjLj_Register
; CHECK-NEXT:    addw $2, %sp
; CHECK-NEXT:    movw $0, -40(%bp)
; CHECK-NEXT:    movw $1, -42(%bp)
; CHECK-NEXT:  .Ltmp0: # EH_LABEL
; CHECK-NEXT:    pushw %si
; CHECK-NEXT:    lcallw $_may_throw@SEG, $_may_throw
; CHECK-NEXT:    addw $2, %sp
; CHECK-NEXT:  .Ltmp1: # EH_LABEL
; CHECK-NEXT:  # %bb.1: # %done
; CHECK-NEXT:    pushw -6(%bp) # 2-byte Folded Reload
; CHECK-NEXT:    lcallw $__Unwind_SjLj_Unregister@SEG, $__Unwind_SjLj_Unregister
; CHECK-NEXT:    addw $2, %sp
; CHECK-NEXT:    xorw %ax, %ax
; CHECK-NEXT:  .LBB0_2: # %done
; CHECK-NEXT:    leaw -4(%bp), %sp
; CHECK-NEXT:    popw %si
; CHECK-NEXT:    popw %di
; CHECK-NEXT:    popw %bp
; CHECK-NEXT:    lretw
; CHECK-NEXT:  .LBB0_3:
; CHECK-NEXT:    movw -42(%bp), %ax
; CHECK-NEXT:    cmpw $1, %ax
; CHECK-NEXT:    jb .LBB0_4
; CHECK-NEXT:  # %bb.5:
; CHECK-NEXT:  .Ltmp3:
; CHECK-NEXT:    int3
; CHECK-NEXT:    jmp .Ltmp3
; CHECK-NEXT:  .LBB0_4:
; CHECK-NEXT:    addw %ax, %ax
; CHECK-NEXT:    movw %ax, %bx
; CHECK-NEXT:    jmpw *%cs:LJTI0_0(%bx)
; CHECK-NEXT:  .LBB0_6: # %lpad
; CHECK-NEXT:  .Ltmp2: # EH_LABEL
; CHECK-NEXT:    movw -38(%bp), %ax
; CHECK-NEXT:    movw -36(%bp), %cx
; CHECK-NEXT:    movw -34(%bp), %dx
; CHECK-NEXT:    movw -32(%bp), %dx
; CHECK-NEXT:    movw $-1, -40(%bp)
; CHECK-NEXT:    movw $-1, -42(%bp)
; CHECK-NEXT:    pushw %cx
; CHECK-NEXT:    pushw %ax
; CHECK-NEXT:    lcallw $___cxa_begin_catch@SEG, $___cxa_begin_catch
; CHECK-NEXT:    addw $4, %sp
; CHECK-NEXT:    movw %ax, %bx
; CHECK-NEXT:    movw %dx, %es
; CHECK-NEXT:    movw %es:(%bx), %si
; CHECK-NEXT:    movw $-1, -40(%bp)
; CHECK-NEXT:    movw $-1, -42(%bp)
; CHECK-NEXT:    lcallw $___cxa_end_catch@SEG, $___cxa_end_catch
; CHECK-NEXT:    pushw -6(%bp) # 2-byte Folded Reload
; CHECK-NEXT:    lcallw $__Unwind_SjLj_Unregister@SEG, $__Unwind_SjLj_Unregister
; CHECK-NEXT:    addw $2, %sp
; CHECK-NEXT:    movw %si, %ax
; CHECK-NEXT:    jmp .LBB0_2
entry:
  invoke addrspace(5) void @may_throw(i16 %x)
          to label %done unwind label %lpad

lpad:
  %lp = landingpad { ptr addrspace(2), i32 }
          catch ptr addrspace(2) @_ZTIi
  %exn = extractvalue { ptr addrspace(2), i32 } %lp, 0
  %obj = call addrspace(5) ptr addrspace(2) @__cxa_begin_catch(ptr addrspace(2) %exn)
  %v = load i16, ptr addrspace(2) %obj
  call addrspace(5) void @__cxa_end_catch()
  ret i16 %v

done:
  ret i16 0
}

; The type table holds far pointers.
; CHECK-LABEL: GCC_except_table0:
; CHECK-NEXT:  .Lexception0:
; CHECK-NEXT:    .byte 255
; CHECK-NEXT:    .byte 3
; CHECK:       # >> Catch TypeInfos <<
; CHECK-NEXT:    .long __ZTIi

declare void @dtor() addrspace(5) nounwind

; A cleanup passes the far exception pointer on to _Unwind_SjLj_Resume.
define void @cleanup(i16 %x) addrspace(5) personality ptr addrspace(5) @__gxx_personality_sj0 {
; CHECK-LABEL: cleanup:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    pushw %bp
; CHECK-NEXT:    movw %sp, %bp
; CHECK-NEXT:    pushw %di
; CHECK-NEXT:    pushw %si
; CHECK-NEXT:    subw $40, %sp
; CHECK-NEXT:    movw 6(%bp), %si
; CHECK-NEXT:    movw $___gxx_personality_sj0@SEG, -20(%bp)
; CHECK-NEXT:    movw $___gxx_personality_sj0, -22(%bp)
; CHECK-NEXT:    movw $GCC_except_table1, -18(%bp)
; CHECK-NEXT:    movw %bp, -16(%bp)
; CHECK-NEXT:    movw %sp, -12(%bp)
; CHECK-NEXT:    movw $.LBB1_2, -14(%bp)
; CHECK-NEXT:    movw %cs, -10(%bp)
; CHECK-NEXT:    leaw -44(%bp), %ax
; CHECK-NEXT:    movw %ax, -6(%bp) # 2-byte Spill
; CHECK-NEXT:    pushw %ax
; CHECK-NEXT:    lcallw $__Unwind_SjLj_Register@SEG, $__Unwind_SjLj_Register
; CHECK-NEXT:    addw $2, %sp
; CHECK-NEXT:    movw $0, -40(%bp)
; CHECK-NEXT:    movw $1, -42(%bp)
; CHECK-NEXT:  .Ltmp4: # EH_LABEL
; CHECK-NEXT:    pushw %si
; CHECK-NEXT:    lcallw $_may_throw@SEG, $_may_throw
; CHECK-NEXT:    addw $2, %sp
; CHECK-NEXT:  .Ltmp5: # EH_LABEL
; CHECK-NEXT:  # %bb.1: # %done
; CHECK-NEXT:    pushw -6(%bp) # 2-byte Folded Reload
; CHECK-NEXT:    lcallw $__Unwind_SjLj_Unregister@SEG, $__Unwind_SjLj_Unregister
; CHECK-NEXT:    addw $2, %sp
; CHECK-NEXT:    leaw -4(%bp), %sp
; CHECK-NEXT:    popw %si
; CHECK-NEXT:    popw %di
; CHECK-NEXT:    popw %bp
; CHECK-NEXT:    lretw
; CHECK-NEXT:  .LBB1_2:
; CHECK-NEXT:    movw -42(%bp), %ax
; CHECK-NEXT:    cmpw $1, %ax
; CHECK-NEXT:    jb .LBB1_3
; CHECK-NEXT:  # %bb.4:
; CHECK-NEXT:  .Ltmp7:
; CHECK-NEXT:    int3
; CHECK-NEXT:    jmp .Ltmp7
; CHECK-NEXT:  .LBB1_3:
; CHECK-NEXT:    addw %ax, %ax
; CHECK-NEXT:    movw %ax, %bx
; CHECK-NEXT:    jmpw *%cs:LJTI1_0(%bx)
; CHECK-NEXT:  .LBB1_5: # %lpad
; CHECK-NEXT:  .Ltmp6: # EH_LABEL
; CHECK-NEXT:    movw -38(%bp), %si
; CHECK-NEXT:    movw -36(%bp), %di
; CHECK-NEXT:    lcallw $_dtor@SEG, $_dtor
; CHECK-NEXT:    movw $-1, -40(%bp)
; CHECK-NEXT:    movw $-1, -42(%bp)
; CHECK-NEXT:    pushw %di
; CHECK-NEXT:    pushw %si
; CHECK-NEXT:    lcallw $__Unwind_SjLj_Resume@SEG, $__Unwind_SjLj_Resume
entry:
  invoke addrspace(5) void @may_throw(i16 %x)
          to label %done unwind label %lpad

lpad:
  %lp = landingpad { ptr addrspace(2), i32 }
          cleanup
  call addrspace(5) void @dtor()
  resume { ptr addrspace(2), i32 } %lp

done:
  ret void
}

