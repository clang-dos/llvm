1 MENU
BEGIN
  POPUP "&File"
  BEGIN
    MENUITEM "&Open", 101
    MENUITEM SEPARATOR
    MENUITEM "E&xit", 102
  END
END
STRINGTABLE
BEGIN
  1 "Hi"
END
2 ACCELERATORS
BEGIN
  "^O", 101
  0x73, 102, VIRTKEY, ALT
END
3 DIALOG 1, 2, 30, 40
STYLE 0x80C80080
CAPTION "Ab"
FONT 8, "Sys"
BEGIN
  LTEXT "N", -1, 1, 2, 3, 4
  CONTROL "B", 7, "button", 0x50010000, 5, 6, 7, 8
END
4 RCDATA
BEGIN
  0x1234, "ab"
END
1 VERSIONINFO
FILEVERSION 1, 2, 3, 4
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "A", "xy\0"
    END
  END
END
