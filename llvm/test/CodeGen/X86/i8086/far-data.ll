; CHECK-NEXT:    movw %sp, %bp
; CHECK-NEXT:    pushw 12(%bp)
; CHECK-NEXT:    pushw 10(%bp)
; CHECK-NEXT:    pushw 8(%bp)
; CHECK-NEXT:    pushw 6(%bp)
; CHECK-NEXT:    pushw 4(%bp)
; CHECK-NEXT:    callw _memcpy
; CHECK-NEXT:    addw $10, %sp
; CHECK-NEXT:    popw %bp
