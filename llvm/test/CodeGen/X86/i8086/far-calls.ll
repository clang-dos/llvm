; RUN: llc -mtriple=i8086-pc-msdos -target-abi=medium -filetype=obj %s -o %t.obj
; RUN: %python %S/../../../MC/X86/i8086/Inputs/omfdump.py %t.obj \
; RUN:   | FileCheck %s --check-prefix=OBJ

