; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; Real 16-bit code for the i8086 target: a BP frame (SP can't be a base
; register on the 8086), cdecl arguments in 2-byte stack slots, results in
; AL/AX, and a 16-bit return. The code generator reports an error for any
; instruction the CPU lacks, so these tests also check that no 80186 or
; 80386 instructions are used.
; RUN: llc -mtriple=i8086-unknown-unknown < %s | FileCheck %s
; RUN: llc -mtriple=i8086-unknown-unknown -O0 < %s | FileCheck %s --check-prefix=O0

define i16 @add(i16 %a, i16 %b) {
; CHECK-LABEL: add:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushw %bp
; CHECK-NEXT:    movw %sp, %bp
; CHECK-NEXT:    movw 4(%bp), %ax
; CHECK-NEXT:    addw 6(%bp), %ax
; CHECK-NEXT:    popw %bp
; CHECK-NEXT:    retw
;
; O0-LABEL: add:
; O0:       # %bb.0:
; O0-NEXT:    pushw %bp
; O0-NEXT:    movw %sp, %bp
; O0-NEXT:    movw 6(%bp), %cx
; O0-NEXT:    movw 4(%bp), %ax
; O0-NEXT:    addw %cx, %ax
; O0-NEXT:    popw %bp
; O0-NEXT:    retw
  %c = add i16 %a, %b
  ret i16 %c
}

