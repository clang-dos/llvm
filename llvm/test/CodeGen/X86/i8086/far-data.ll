; A select of two loads becomes a load through a selected far address.
define i16 @select_load(i1 %c, ptr addrspace(2) %p) nounwind {
; CHECK-LABEL: select_load:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushw %bp
; CHECK-NEXT:    movw %sp, %bp
; CHECK-NEXT:    testb $1, 4(%bp)
; CHECK-NEXT:    jne .LBB4_1
; CHECK-NEXT:  # %bb.2:
; CHECK-NEXT:    movw $_h, %ax
; CHECK-NEXT:    je .LBB4_5
; CHECK-NEXT:  .LBB4_4:
; CHECK-NEXT:    movw 8(%bp), %cx
; CHECK-NEXT:    jmp .LBB4_6
; CHECK-NEXT:  .LBB4_1:
; CHECK-NEXT:    movw 6(%bp), %ax
; CHECK-NEXT:    jne .LBB4_4
; CHECK-NEXT:  .LBB4_5:
; CHECK-NEXT:    movw %ds, %cx
; CHECK-NEXT:  .LBB4_6:
; CHECK-NEXT:    movw %cx, %es
; CHECK-NEXT:    movw %ax, %bx
; CHECK-NEXT:    movw %es:(%bx), %ax
; CHECK-NEXT:    popw %bp
; CHECK-NEXT:    retw
  %n = addrspacecast ptr @h to ptr addrspace(2)
  %a = load i16, ptr addrspace(2) %p, align 2
  %b = load i16, ptr addrspace(2) %n, align 2
  %v = select i1 %c, i16 %a, i16 %b
  ret i16 %v
}

