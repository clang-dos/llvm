; Tuning for a modern CPU must not bring in 386 instructions. A 16-bit shift
; right by 8 used to select MOVZX32 (an h-register pattern) when tuned for
; "generic", which clang's driver used to pass by default.
; RUN: llc -mtriple=i8086-unknown-unknown -verify-machineinstrs < %s | FileCheck %s

define i16 @high_byte(i16 %x, i16 %y) "tune-cpu"="generic" {
; CHECK-LABEL: high_byte:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushw %bp
; CHECK-NEXT:    movw %sp, %bp
; CHECK-NEXT:    movw 4(%bp), %ax
; CHECK-NEXT:    addw 6(%bp), %ax
; CHECK-NEXT:    movb $8, %cl
; CHECK-NEXT:    shrw %cl, %ax
; CHECK-NEXT:    popw %bp
; CHECK-NEXT:    retw
  %s = add i16 %x, %y
  %r = lshr i16 %s, 8
  ret i16 %r
}

