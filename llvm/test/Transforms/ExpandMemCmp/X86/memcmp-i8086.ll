; CHECK-SAME: ptr readonly captures(none) [[X:%.*]], ptr readonly captures(none) [[Y:%.*]]) addrspace(4) {
; CHECK-NEXT:    [[TMP1:%.*]] = load i8, ptr [[X]], align 1
; CHECK-NEXT:    [[TMP2:%.*]] = load i8, ptr [[Y]], align 1
; CHECK-NEXT:    [[TMP3:%.*]] = zext i8 [[TMP1]] to i16
; CHECK-NEXT:    [[TMP4:%.*]] = zext i8 [[TMP2]] to i16
; CHECK-NEXT:    [[TMP5:%.*]] = sub i16 [[TMP3]], [[TMP4]]
; CHECK-NEXT:    ret i16 [[TMP5]]
;
  %call = tail call i16 @memcmp(ptr %x, ptr %y, i16 1)
  ret i16 %call
}

