; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m68k-unknown-amigaos < %s | FileCheck %s

; AmigaOS returns pointers in d0, as OS functions and Amiga compilers do,
; and passes the struct-return pointer in a1, as gcc does. The callee
; doesn't pop it.

declare ptr @OpenLibrary(ptr, i32)

define ptr @ret_ptr(ptr %p) {
; CHECK-LABEL: ret_ptr:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ; %bb.0:
; CHECK-NEXT:    move.l (4,%sp), %d0
; CHECK-NEXT:    rts
  ret ptr %p
}

define i32 @use_ptr(ptr %name) {
; CHECK-LABEL: use_ptr:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ; %bb.0:
; CHECK-NEXT:    suba.l #12, %sp
; CHECK-NEXT:    .cfi_def_cfa_offset -16
; CHECK-NEXT:    move.l (16,%sp), %d0
; CHECK-NEXT:    move.l %d0, (%sp)
; CHECK-NEXT:    clr.l (4,%sp)
; CHECK-NEXT:    jsr OpenLibrary
; CHECK-NEXT:    move.l %d0, %a0
; CHECK-NEXT:    move.l (%a0), %d0
; CHECK-NEXT:    adda.l #12, %sp
; CHECK-NEXT:    rts
  %b = call ptr @OpenLibrary(ptr %name, i32 0)
  %v = load i32, ptr %b
  ret i32 %v
}

%struct.S = type { i32, i32, i32 }

define void @make(ptr sret(%struct.S) %out, i32 %x) {
; CHECK-LABEL: make:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ; %bb.0:
; CHECK-NEXT:    move.l (4,%sp), (8,%a1)
; CHECK-NEXT:    move.l %a1, %d0
; CHECK-NEXT:    rts
  %p = getelementptr inbounds %struct.S, ptr %out, i32 0, i32 2
  store i32 %x, ptr %p
  ret void
}

define i32 @call_make() {
; CHECK-LABEL: call_make:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ; %bb.0:
; CHECK-NEXT:    suba.l #20, %sp
; CHECK-NEXT:    .cfi_def_cfa_offset -24
; CHECK-NEXT:    move.l #7, (%sp)
; CHECK-NEXT:    lea (8,%sp), %a1
; CHECK-NEXT:    jsr make
; CHECK-NEXT:    move.l (16,%sp), %d0
; CHECK-NEXT:    adda.l #20, %sp
; CHECK-NEXT:    rts
  %s = alloca %struct.S
  call void @make(ptr sret(%struct.S) %s, i32 7)
  %p = getelementptr inbounds %struct.S, ptr %s, i32 0, i32 2
  %v = load i32, ptr %p
  ret i32 %v
}
