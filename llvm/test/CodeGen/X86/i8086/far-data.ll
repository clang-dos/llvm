declare void @llvm.va_end.p2(ptr addrspace(2))
define i16 @va(i16 %n, ...) nounwind {
; CHECK-LABEL: va:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushw %bp
; CHECK-NEXT:    movw %sp, %bp
; CHECK-NEXT:    subw $4, %sp
; CHECK-NEXT:    movw %ds, %cx
; CHECK-NEXT:    movw %cx, -2(%bp)
