; Traps: UD2 is not an 8086 instruction (0F is POP CS), so trap with INT3 in a
; loop. debugtrap stays a single INT3.
define void @trap() {
; CHECK-LABEL: trap:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushw %bp
; CHECK-NEXT:    movw %sp, %bp
; CHECK-NEXT:  .Ltmp0:
; CHECK-NEXT:    int3
; CHECK-NEXT:    jmp .Ltmp0
  call void @llvm.trap()
  unreachable
}

define void @ubsantrap() {
; CHECK-LABEL: ubsantrap:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushw %bp
; CHECK-NEXT:    movw %sp, %bp
; CHECK-NEXT:  .Ltmp1:
; CHECK-NEXT:    int3
; CHECK-NEXT:    jmp .Ltmp1
  call void @llvm.ubsantrap(i8 3)
  unreachable
}

define void @debugtrap() {
; CHECK-LABEL: debugtrap:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushw %bp
; CHECK-NEXT:    movw %sp, %bp
; CHECK-NEXT:    int3
; CHECK-NEXT:    popw %bp
; CHECK-NEXT:    retw
  call void @llvm.debugtrap()
  ret void
}

; Masking with 0xff is an AND: the 8086 has no MOVZX.
define i16 @mask_low_byte(i16 %x) {
; CHECK-LABEL: mask_low_byte:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushw %bp
; CHECK-NEXT:    movw %sp, %bp
; CHECK-NEXT:    movb 4(%bp), %cl
; CHECK-NEXT:    xorw %ax, %ax
; CHECK-NEXT:    movb %cl, %al
; CHECK-NEXT:    popw %bp
; CHECK-NEXT:    retw
  %r = and i16 %x, 255
  ret i16 %r
}

