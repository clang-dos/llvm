; The 16-bit ABI does not keep ES equal to DS, so constant-size copies and
; fills are not lowered to REP MOVS or REP STOS.

define void @copy(ptr %d, ptr %s) {
; CHECK-LABEL: copy:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushw %bp
; CHECK-NEXT:    movw %sp, %bp
; CHECK-NEXT:    movw $200, %ax
; CHECK-NEXT:    pushw %ax
; CHECK-NEXT:    pushw 6(%bp)
; CHECK-NEXT:    pushw 4(%bp)
; CHECK-NEXT:    callw _memcpy
; CHECK-NEXT:    addw $6, %sp
; CHECK-NEXT:    popw %bp
; CHECK-NEXT:    retw
  call void @llvm.memcpy.p0.p0.i16(ptr align 1 %d, ptr align 1 %s, i16 200, i1 false)
  ret void
}

