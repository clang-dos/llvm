; CHECK-NEXT:    movw %ax, -4(%bp)
; CHECK-NEXT:    movw %ds:6(%bp), %ax
; CHECK-NEXT:    movw %cx, -2(%bp)
; CHECK-NEXT:    leaw 8(%bp), %cx
; CHECK-NEXT:    movw %cx, -4(%bp)
