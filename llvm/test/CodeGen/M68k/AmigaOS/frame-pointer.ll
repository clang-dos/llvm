; RUN: llc -mtriple=m68k-unknown-amigaos -frame-pointer=all < %s | FileCheck %s
; RUN: llc -mtriple=m68k-linux -frame-pointer=all < %s | FileCheck %s --check-prefix=LINUX

; AmigaOS passes the library base in a6 to every OS call, so the frame
; pointer is a5, and a6 is an ordinary callee-saved register.

declare i32 @g(ptr)

define i32 @f(i32 %x) {
; CHECK-LABEL: f:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ; %bb.0:
; CHECK-NEXT:    link.w %a5, #-8
; CHECK-NEXT:    .cfi_def_cfa_offset -8
; CHECK-NEXT:    .cfi_offset %a5, -8
; CHECK-NEXT:    .cfi_def_cfa_register %a5
; CHECK-NEXT:    lea (8,%a5), %a0
; CHECK-NEXT:    move.l %a0, (%sp)
; CHECK-NEXT:    jsr g
; CHECK-NEXT:    unlk %a5
; CHECK-NEXT:    rts
;
; LINUX-LABEL: f:
; LINUX:         .cfi_startproc
; LINUX-NEXT:  ; %bb.0:
; LINUX-NEXT:    link.w %a6, #-8
; LINUX-NEXT:    .cfi_def_cfa_offset -8
; LINUX-NEXT:    .cfi_offset %a6, -8
; LINUX-NEXT:    .cfi_def_cfa_register %a6
; LINUX-NEXT:    lea (8,%a6), %a0
; LINUX-NEXT:    move.l %a0, (%sp)
; LINUX-NEXT:    jsr g
; LINUX-NEXT:    unlk %a6
; LINUX-NEXT:    rts
  %a = alloca i32
  store i32 %x, ptr %a
  %r = call i32 @g(ptr %a)
  ret i32 %r
}

; An asm statement that clobbers a6 makes the function save and restore it,
; and locals stay addressed through a5.
define i32 @libcall(i32 %x) {
; CHECK-LABEL: libcall:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ; %bb.0:
; CHECK-NEXT:    link.w %a5, #-4
; CHECK-NEXT:    .cfi_def_cfa_offset -8
; CHECK-NEXT:    .cfi_offset %a5, -8
; CHECK-NEXT:    .cfi_def_cfa_register %a5
; CHECK-NEXT:    movem.l %a6, (-4,%a5) ; 8-byte Folded Spill
; CHECK-NEXT:    ;APP
; CHECK-NEXT:    move.l #0, %a6
; CHECK-NEXT:    jsr (-48,%a6)
; CHECK-NEXT:    ;NO_APP
; CHECK-NEXT:    move.l (8,%a5), %d0
; CHECK-NEXT:    movem.l (-4,%a5), %a6 ; 8-byte Folded Reload
; CHECK-NEXT:    unlk %a5
; CHECK-NEXT:    rts
;
; LINUX-LABEL: libcall:
; LINUX:         .cfi_startproc
; LINUX-NEXT:  ; %bb.0:
; LINUX-NEXT:    link.w %a6, #0
; LINUX-NEXT:    .cfi_def_cfa_offset -8
; LINUX-NEXT:    .cfi_offset %a6, -8
; LINUX-NEXT:    .cfi_def_cfa_register %a6
; LINUX-NEXT:    ;APP
; LINUX-NEXT:    move.l #0, %a6
; LINUX-NEXT:    jsr (-48,%a6)
; LINUX-NEXT:    ;NO_APP
; LINUX-NEXT:    move.l (8,%a6), %d0
; LINUX-NEXT:    unlk %a6
; LINUX-NEXT:    rts
  %a = alloca i32
  store volatile i32 %x, ptr %a
  call void asm sideeffect "move.l #0,%a6\0A\09jsr (-48,%a6)", "~{a6},~{d0},~{d1},~{a0},~{a1}"()
  %v = load volatile i32, ptr %a
  ret i32 %v
}
