; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m68k-unknown-amigaos < %s | FileCheck %s
; RUN: llc -mtriple=m68k-unknown-amigaos -filetype=obj < %s \
; RUN:   | llvm-readobj -r - | FileCheck %s --check-prefix=RELOC

; AmigaOS loads code, data and bss hunks at unrelated addresses, so data
; and functions are reached with 32-bit absolute addresses (HUNK_RELOC32),
; never 16-bit PC-relative offsets.

@counter = global i32 0
@msg = private constant [6 x i8] c"hello\00"

declare void @puts(ptr)

define void @f() {
; CHECK-LABEL: f:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ; %bb.0:
; CHECK-NEXT:    suba.l #4, %sp
; CHECK-NEXT:    .cfi_def_cfa_offset -8
; CHECK-NEXT:    move.l #counter, %a0
; CHECK-NEXT:    add.l #1, (%a0)
; CHECK-NEXT:    move.l #.Lmsg, (%sp)
; CHECK-NEXT:    jsr puts
; CHECK-NEXT:    adda.l #4, %sp
; CHECK-NEXT:    rts
  %v = load i32, ptr @counter
  %n = add i32 %v, 1
  store i32 %n, ptr @counter
  call void @puts(ptr @msg)
  ret void
}


; RELOC:      Section ({{[0-9]+}}) .rela.text {
; RELOC-NEXT:   0x{{[0-9A-F]+}} R_68K_32 counter 0x0
; RELOC-NEXT:   0x{{[0-9A-F]+}} R_68K_32 .rodata 0x0
; RELOC-NEXT:   0x{{[0-9A-F]+}} R_68K_32 puts 0x0
; RELOC-NEXT: }
