; RUN: llc -mtriple=m68k < %s | FileCheck %s
; A compare with 0 of a truncated arithmetic result uses the flags of the
; narrowed operation (this used to make an invalid node).

define i1 @xor_trunc_eq0(i32 %a, i32 %b) {
; CHECK-LABEL: xor_trunc_eq0:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ; %bb.0:
; CHECK-NEXT:    move.b (11,%sp), %d0
; CHECK-NEXT:    move.b (7,%sp), %d1
; CHECK-NEXT:    eor.b %d0, %d1
; CHECK-NEXT:    seq %d0
; CHECK-NEXT:    rts
  %x = xor i32 %a, %b
  %t = trunc i32 %x to i8
  %c = icmp eq i8 %t, 0
  ret i1 %c
}
define i1 @add_trunc_ne0(i32 %a, i32 %b) {
; CHECK-LABEL: add_trunc_ne0:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ; %bb.0:
; CHECK-NEXT:    move.w (6,%sp), %d0
; CHECK-NEXT:    add.w (10,%sp), %d0
; CHECK-NEXT:    sne %d0
; CHECK-NEXT:    rts
  %x = add i32 %a, %b
  %t = trunc i32 %x to i16
