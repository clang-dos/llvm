; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; A select between two values loaded through far pointers. The DAG combine
; that turns it into a load through a select of the addresses must not fire
; while one address has been rewritten to a 16-bit X86ISD::FARADDR and the
; other is still a 32-bit far pointer: it used to build a select of i16 and
; i32 operands and crash ("do not know how to expand this operator's
; operand!" without assertions).
; RUN: llc -mtriple=i8086-pc-msdos -target-abi=compact < %s | FileCheck %s
; RUN: llc -mtriple=i8086-pc-msdos -target-abi=large < %s | FileCheck %s --check-prefix=LARGE
; RUN: llc -mtriple=i8086-pc-msdos -target-abi=huge < %s | FileCheck %s --check-prefix=HUGE
; RUN: llc -O0 -mtriple=i8086-pc-msdos -target-abi=compact < %s -o /dev/null

%struct.S = type { i16, i16, i16, i16 }

@g = global %struct.S zeroinitializer, align 2

; Fields of a near global accessed through far pointers (C in the compact,
; large and huge models).
define i16 @select_fields() nounwind {
; CHECK-LABEL: select_fields:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushw %bp
; CHECK-NEXT:    movw %sp, %bp
; CHECK-NEXT:    pushw %ds
; CHECK-NEXT:    popw %es
; CHECK-NEXT:    cmpw $0, %ds:_g+4
; CHECK-NEXT:    movw $_g+6, %ax
; CHECK-NEXT:    je .LBB0_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    movw $_g+2, %ax
; CHECK-NEXT:  .LBB0_2:
; CHECK-NEXT:    movw %ax, %bx
; CHECK-NEXT:    movw %es:(%bx), %ax
; CHECK-NEXT:    popw %bp
; CHECK-NEXT:    retw
;
; LARGE-LABEL: select_fields:
; LARGE:       # %bb.0:
; LARGE-NEXT:    pushw %bp
; LARGE-NEXT:    movw %sp, %bp
; LARGE-NEXT:    pushw %ds
; LARGE-NEXT:    popw %es
; LARGE-NEXT:    cmpw $0, %ds:_g+4
; LARGE-NEXT:    movw $_g+6, %ax
; LARGE-NEXT:    je .LBB0_2
; LARGE-NEXT:  # %bb.1:
; LARGE-NEXT:    movw $_g+2, %ax
; LARGE-NEXT:  .LBB0_2:
; LARGE-NEXT:    movw %ax, %bx
; LARGE-NEXT:    movw %es:(%bx), %ax
; LARGE-NEXT:    popw %bp
; LARGE-NEXT:    lretw
;
; HUGE-LABEL: select_fields:
; HUGE:       # %bb.0:
; HUGE-NEXT:    pushw %bp
; HUGE-NEXT:    movw %sp, %bp
; HUGE-NEXT:    pushw %ds
; HUGE-NEXT:    popw %es
; HUGE-NEXT:    cmpw $0, %ds:_g+4
; HUGE-NEXT:    movw $_g+6, %ax
; HUGE-NEXT:    je .LBB0_2
; HUGE-NEXT:  # %bb.1:
; HUGE-NEXT:    movw $_g+2, %ax
; HUGE-NEXT:  .LBB0_2:
; HUGE-NEXT:    movw %ax, %bx
; HUGE-NEXT:    movw %es:(%bx), %ax
; HUGE-NEXT:    popw %bp
; HUGE-NEXT:    lretw
  %c = load i16, ptr addrspace(2) getelementptr inbounds nuw (i8, ptr addrspace(2) addrspacecast (ptr @g to ptr addrspace(2)), i16 4), align 2
  %z = icmp eq i16 %c, 0
  %a = load i16, ptr addrspace(2) getelementptr inbounds nuw (i8, ptr addrspace(2) addrspacecast (ptr @g to ptr addrspace(2)), i16 2), align 2
  %b = load i16, ptr addrspace(2) getelementptr inbounds nuw (i8, ptr addrspace(2) addrspacecast (ptr @g to ptr addrspace(2)), i16 6), align 2
  %r = select i1 %z, i16 %b, i16 %a
  ret i16 %r
}

