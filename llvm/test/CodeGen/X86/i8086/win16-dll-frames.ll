; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=i8086-pc-win16 < %s | FileCheck %s
; 16-bit Windows DLL code in the near data models (safestack, from clang
; -mwindows-dll) keeps the locals whose address escapes in a frame in
; DGROUP, below the pointer that __win16_frame_pointer_address returns, so
; that near pointers to them work while SS is the caller's stack. Frames
; keep the 2-byte stack alignment. A local whose address does not escape
; stays on the stack.

declare void @use(ptr)

define i16 @f(i16 %x) safestack {
; CHECK-LABEL: f:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushw %bp
; CHECK-NEXT:    movw %sp, %bp
; CHECK-NEXT:    pushw %di
; CHECK-NEXT:    pushw %si
; CHECK-NEXT:    callw ___win16_frame_pointer_address
; CHECK-NEXT:    movw %ax, %si
; CHECK-NEXT:    movw %ax, %bx
; CHECK-NEXT:    movw (%bx), %di
; CHECK-NEXT:    movw %di, %ax
; CHECK-NEXT:    addw $-8, %ax
; CHECK-NEXT:    movw %si, %bx
; CHECK-NEXT:    movw %ax, (%bx)
; CHECK-NEXT:    pushw %ax
; CHECK-NEXT:    callw _use
; CHECK-NEXT:    addw $2, %sp
; CHECK-NEXT:    movw %di, %bx
; CHECK-NEXT:    movw -8(%bx), %ax
; CHECK-NEXT:    addw 4(%bp), %ax
; CHECK-NEXT:    movw %di, (%si)
; CHECK-NEXT:    popw %si
; CHECK-NEXT:    popw %di
; CHECK-NEXT:    popw %bp
; CHECK-NEXT:    retw
  %a = alloca [4 x i16], align 2
  %b = alloca i16, align 2
  store volatile i16 %x, ptr %b
  call void @use(ptr %a)
  %v = load i16, ptr %a
  %w = load volatile i16, ptr %b
  %r = add i16 %v, %w
  ret i16 %r
}

; A far pointer to a local in the DGROUP frame takes DS, not SS.
declare void @usefar(ptr addrspace(2))

define void @far_to_frame() safestack {
; CHECK-LABEL: far_to_frame:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushw %bp
; CHECK-NEXT:    movw %sp, %bp
; CHECK-NEXT:    pushw %di
; CHECK-NEXT:    pushw %si
; CHECK-NEXT:    callw ___win16_frame_pointer_address
; CHECK-NEXT:    movw %ax, %si
; CHECK-NEXT:    movw %ds, %ax
; CHECK-NEXT:    movw %si, %bx
; CHECK-NEXT:    movw (%bx), %di
; CHECK-NEXT:    movw %di, %cx
; CHECK-NEXT:    addw $-16, %cx
; CHECK-NEXT:    movw %cx, (%bx)
; CHECK-NEXT:    pushw %ax
; CHECK-NEXT:    pushw %cx
; CHECK-NEXT:    callw _usefar
; CHECK-NEXT:    addw $4, %sp
; CHECK-NEXT:    movw %di, (%si)
; CHECK-NEXT:    popw %si
; CHECK-NEXT:    popw %di
; CHECK-NEXT:    popw %bp
; CHECK-NEXT:    retw
  %a = alloca [8 x i16], align 2
  %p = addrspacecast ptr %a to ptr addrspace(2)
  call void @usefar(ptr addrspace(2) %p)
  ret void
}
