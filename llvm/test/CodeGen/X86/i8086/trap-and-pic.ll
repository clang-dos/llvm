; There is no GOT in real mode: PIC is the same as static.
@g = global i16 0
define i16 @load_global() {
; CHECK-LABEL: load_global:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushw %bp
; CHECK-NEXT:    movw %sp, %bp
; CHECK-NEXT:    movw _g, %ax
; CHECK-NEXT:    popw %bp
; CHECK-NEXT:    retw
