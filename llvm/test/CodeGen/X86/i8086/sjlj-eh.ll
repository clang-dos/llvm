; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; C++ exceptions on i8086 use SjLj function contexts. The context holds a
; near prev pointer, an i32 call site, four i32 data words, the personality
; (a near or far code pointer), a near LSDA pointer and the jump buffer:
; BP, the dispatch's offset, SP and, with far code, the dispatch's segment.
; The exception table's type entries are near pointers (udata2) or, with far
; data, far ones (udata4): see sjlj-eh-far.ll.
; RUN: llc -mtriple=i8086-pc-msdos -target-abi=small < %s | FileCheck %s --check-prefix=CHECK

@_ZTIi = external constant ptr

declare void @may_throw(i16)
declare i32 @__gxx_personality_sj0(...)
declare ptr @__cxa_begin_catch(ptr)
declare void @__cxa_end_catch()

; The dispatch: the call site picks the landing pad from a table in CS.
define i16 @catcher(i16 %x) personality ptr addrspace(4) @__gxx_personality_sj0 {
; CHECK-LABEL: catcher:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    pushw %bp
; CHECK-NEXT:    movw %sp, %bp
; CHECK-NEXT:    pushw %di
; CHECK-NEXT:    pushw %si
; CHECK-NEXT:    subw $38, %sp
; CHECK-NEXT:    movw 4(%bp), %si
; CHECK-NEXT:    movw $___gxx_personality_sj0, -20(%bp)
; CHECK-NEXT:    movw $GCC_except_table0, -18(%bp)
; CHECK-NEXT:    movw %bp, -16(%bp)
; CHECK-NEXT:    movw %sp, -12(%bp)
; CHECK-NEXT:    movw $.LBB0_3, -14(%bp)
; CHECK-NEXT:    leaw -42(%bp), %ax
; CHECK-NEXT:    movw %ax, -6(%bp) # 2-byte Spill
; CHECK-NEXT:    pushw %ax
; CHECK-NEXT:    callw __Unwind_SjLj_Register
; CHECK-NEXT:    addw $2, %sp
; CHECK-NEXT:    movw $0, -38(%bp)
; CHECK-NEXT:    movw $1, -40(%bp)
; CHECK-NEXT:  .Ltmp0: # EH_LABEL
; CHECK-NEXT:    pushw %si
; CHECK-NEXT:    callw _may_throw
; CHECK-NEXT:    addw $2, %sp
; CHECK-NEXT:  .Ltmp1: # EH_LABEL
; CHECK-NEXT:  # %bb.1: # %done
; CHECK-NEXT:    pushw -6(%bp) # 2-byte Folded Reload
; CHECK-NEXT:    callw __Unwind_SjLj_Unregister
; CHECK-NEXT:    addw $2, %sp
; CHECK-NEXT:    xorw %ax, %ax
; CHECK-NEXT:  .LBB0_2: # %done
; CHECK-NEXT:    leaw -4(%bp), %sp
; CHECK-NEXT:    popw %si
; CHECK-NEXT:    popw %di
; CHECK-NEXT:    popw %bp
; CHECK-NEXT:    retw
; CHECK-NEXT:  .LBB0_3:
; CHECK-NEXT:    movw -40(%bp), %ax
; CHECK-NEXT:    cmpw $1, %ax
; CHECK-NEXT:    jb .LBB0_4
; CHECK-NEXT:  # %bb.5:
; CHECK-NEXT:  .Ltmp3:
; CHECK-NEXT:    int3
; CHECK-NEXT:    jmp .Ltmp3
; CHECK-NEXT:  .LBB0_4:
; CHECK-NEXT:    addw %ax, %ax
; CHECK-NEXT:    movw %ax, %bx
; CHECK-NEXT:    jmpw *%cs:LJTI0_0(%bx)
; CHECK-NEXT:  .LBB0_6: # %lpad
; CHECK-NEXT:  .Ltmp2: # EH_LABEL
; CHECK-NEXT:    movw -36(%bp), %ax
; CHECK-NEXT:    movw -34(%bp), %cx
; CHECK-NEXT:    movw -32(%bp), %cx
; CHECK-NEXT:    movw -30(%bp), %cx
; CHECK-NEXT:    movw $-1, -38(%bp)
; CHECK-NEXT:    movw $-1, -40(%bp)
; CHECK-NEXT:    pushw %ax
; CHECK-NEXT:    callw ___cxa_begin_catch
; CHECK-NEXT:    addw $2, %sp
; CHECK-NEXT:    movw %ax, %bx
; CHECK-NEXT:    movw (%bx), %si
; CHECK-NEXT:    movw $-1, -38(%bp)
; CHECK-NEXT:    movw $-1, -40(%bp)
; CHECK-NEXT:    callw ___cxa_end_catch
; CHECK-NEXT:    pushw -6(%bp) # 2-byte Folded Reload
; CHECK-NEXT:    callw __Unwind_SjLj_Unregister
; CHECK-NEXT:    addw $2, %sp
; CHECK-NEXT:    movw %si, %ax
; CHECK-NEXT:    jmp .LBB0_2
entry:
  invoke void @may_throw(i16 %x)
          to label %done unwind label %lpad

lpad:
  %lp = landingpad { ptr, i32 }
          catch ptr @_ZTIi
  %exn = extractvalue { ptr, i32 } %lp, 0
  %obj = call ptr @__cxa_begin_catch(ptr %exn)
  %v = load i16, ptr %obj
  call void @__cxa_end_catch()
  ret i16 %v

done:
  ret i16 0
}

