; M68020-NEXT:    muls %d1, %d0
; M68020-NEXT:    and.l #255, %d0
; M68020-NEXT:    rts
entry:
  %smul = tail call { i8, i1 } @llvm.smul.with.overflow.i8(i8 %a, i8 %b)
  %cmp = extractvalue { i8, i1 } %smul, 1
