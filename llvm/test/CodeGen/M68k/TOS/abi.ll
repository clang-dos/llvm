; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m68k-atari-tos < %s | FileCheck %s

; Atari TOS follows gcc for the Atari: pointers are returned in d0, the
; struct-return pointer is passed in a1 and not popped by the callee, and
; the frame pointer is a6.

declare ptr @Malloc(i32)

define ptr @ret_ptr(ptr %p) {
; CHECK-LABEL: ret_ptr:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ; %bb.0:
; CHECK-NEXT:    move.l (4,%sp), %d0
; CHECK-NEXT:    rts
  ret ptr %p
}

define i32 @use_ptr(i32 %n) {
; CHECK-LABEL: use_ptr:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ; %bb.0:
; CHECK-NEXT:    suba.l #4, %sp
; CHECK-NEXT:    .cfi_def_cfa_offset -8
; CHECK-NEXT:    move.l (8,%sp), %d0
; CHECK-NEXT:    move.l %d0, (%sp)
; CHECK-NEXT:    jsr Malloc
; CHECK-NEXT:    move.l %d0, %a0
; CHECK-NEXT:    move.l (%a0), %d0
; CHECK-NEXT:    adda.l #4, %sp
; CHECK-NEXT:    rts
  %b = call ptr @Malloc(i32 %n)
  %v = load i32, ptr %b
  ret i32 %v
}

%struct.S = type { i32, i32, i32 }

define void @make(ptr sret(%struct.S) %out, i32 %x) {
; CHECK-LABEL: make:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ; %bb.0:
; CHECK-NEXT:    move.l (4,%sp), (%a1)
; CHECK-NEXT:    move.l %a1, %d0
; CHECK-NEXT:    rts
  store i32 %x, ptr %out
  ret void
}

define i32 @call_make(i32 %x) {
; CHECK-LABEL: call_make:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ; %bb.0:
; CHECK-NEXT:    suba.l #20, %sp
; CHECK-NEXT:    .cfi_def_cfa_offset -24
; CHECK-NEXT:    move.l (24,%sp), %d0
; CHECK-NEXT:    move.l %d0, (%sp)
; CHECK-NEXT:    lea (8,%sp), %a1
; CHECK-NEXT:    jsr make
; CHECK-NEXT:    move.l (8,%sp), %d0
; CHECK-NEXT:    adda.l #20, %sp
; CHECK-NEXT:    rts
  %s = alloca %struct.S
  call void @make(ptr sret(%struct.S) %s, i32 %x)
  %v = load i32, ptr %s
  ret i32 %v
}

define i32 @frame(i32 %n) "frame-pointer"="all" {
; CHECK-LABEL: frame:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ; %bb.0:
; CHECK-NEXT:    link.w %a6, #-24
; CHECK-NEXT:    .cfi_def_cfa_offset -8
; CHECK-NEXT:    .cfi_offset %a6, -8
; CHECK-NEXT:    .cfi_def_cfa_register %a6
; CHECK-NEXT:    move.l (8,%a6), %d0
; CHECK-NEXT:    move.l %d0, (4,%sp)
; CHECK-NEXT:    lea (-16,%a6), %a0
; CHECK-NEXT:    move.l %a0, (%sp)
; CHECK-NEXT:    jsr fill
; CHECK-NEXT:    move.l (-16,%a6), %d0
; CHECK-NEXT:    unlk %a6
; CHECK-NEXT:    rts
  %a = alloca [16 x i8]
  call void @fill(ptr %a, i32 %n)
  %v = load i32, ptr %a
  ret i32 %v
}

declare void @fill(ptr, i32)
