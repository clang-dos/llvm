; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=m68k-atari-tos < %s | FileCheck %s
; RUN: llc -mtriple=m68k-atari-tos -filetype=obj < %s \
; RUN:   | llvm-readobj -r - | FileCheck %s --check-prefix=RELOC

; Atari TOS programs reach data and functions with 32-bit absolute
; addresses, each an entry in the PRG fixup table, so that programs with
; more than 32K of code work.

@counter = global i32 0
@msg = private constant [6 x i8] c"hello\00"

declare void @puts(ptr)

define void @f() {
; CHECK-LABEL: f:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  ; %bb.0:
; CHECK-NEXT:    suba.l #4, %sp
; CHECK-NEXT:    .cfi_def_cfa_offset -8
; CHECK-NEXT:    move.l #counter, %a0
; CHECK-NEXT:    add.l #1, (%a0)
; CHECK-NEXT:    move.l #.Lmsg, (%sp)
; CHECK-NEXT:    jsr puts
; CHECK-NEXT:    adda.l #4, %sp
; CHECK-NEXT:    rts
  %c = load i32, ptr @counter
  %d = add i32 %c, 1
  store i32 %d, ptr @counter
  call void @puts(ptr @msg)
  ret void
}

; RELOC-NOT: R_68K_PC
; RELOC: R_68K_32 counter
